<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestData.fs" />
        <Compile Include="ReaderBuildTests.fs" />
        <Compile Include="ReaderExecuteTests.fs" />
        <Compile Include="WriterBuildTests.fs" />
        <Compile Include="WriterExecutionTests.fs" />
        <Compile Include="MongoExpressionBuilderTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DnsClient" Version="1.8.0" />
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageReference Include="MongoDB.Bson" Version="3.8.1" />
        <PackageReference Include="MongoDB.Driver" Version="3.8.1" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="FSharp.Core" Version="10.1.300" />
        <PackageReference Include="SharpCompress" Version="0.48.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Iezious.Libs.BSONExpressionSerializer\Iezious.Libs.BSONExpressionSerializer.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="**\AGENTS.md" />
    </ItemGroup>

</Project>
